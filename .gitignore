logs/
*.log
*.tmp
*.bak
*.swp
*~

# Environment / local config (never commit secrets)
.env
.env.*
!.env.example
application-dev.yml
application-dev.properties

# Helm
helm/*/charts/
helm/*/Chart.lock
*.tgz

# Docker
docker-compose.override.yml
compose.override.yaml
